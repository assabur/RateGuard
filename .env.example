# Required only for live ingestion. Never commit the real key.
FRED_API_KEY=
# Relative paths are resolved from the working directory.
RATE_GUARD_DATA_DIR=data
# Required: PostgreSQL for local execution; use the same password in both settings.
RATE_GUARD_POSTGRES_PASSWORD=replace_with_a_local_password
RATE_GUARD_DATABASE_URL=postgresql+psycopg://rateguard:replace_with_a_local_password@127.0.0.1:5432/rateguard
RATE_GUARD_OK_BPS=2
RATE_GUARD_WARNING_BPS=5
RATE_GUARD_FLAT_BPS=5
RATE_GUARD_MAX_AGE_DAYS=4
RATE_GUARD_JUMP_BPS=100
